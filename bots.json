 "rules": {
  "directorOffice": {
   "bot": "oakley",
   "legend": "总监室 → 首席助理 Oakley 常驻"
  },
  "meetingRoom": {
   "status": "meeting",
   "trigger": "groupChat",
   "minParticipants": 2,
   "capacity": 8,
   "when": "bot 正在同一个群聊中（见 groups，如 学习群）",
   "action": "该群聊的在线成员一起走进会议室；群聊结束后回工位",
   "legend": "群聊中（同一群 ≥2 位）→ 会议室"
  },
  "focusPod": {
   "status": "focus",
   "trigger": "deepWork",
   "minSeconds": 30,
   "capacity": 2,
   "overflow": "desk",
   "when": "连续深度工作超过 30 秒（任务标记 deep，且状态一直是 工作中）",
   "action": "占用一个空闲专注舱；2 个舱都满时留在自己工位专注",
   "legend": "连续深度工作 >30 秒 → 专注舱，满员留工位"
  },
  "lounge": {
   "status": [
    "idle"
   ],
   "legend": "空闲 → 休息区 / 图书角"
  },
  "desk": {
   "status": [
    "working",
    "thinking",
    "browsing",
    "help",
    "done"
   ],
   "legend": "其他状态 → 自己的工位"
  }
